          "45º Hyperextension"
        ],
        "notas": "Squeeze your glutes hard at the top and control the weight on the way down."
      },
      {
        "id": "leg_press",
        "ejercicio": "Leg Press",
        "series_calentamiento": "2-4",
        "series_trabajo": 1,
        "repeticiones": "6-8",
        "descanso": "2-3 min",
        "sustituciones_recomendadas": [
          "Smith Machine Squat",
          "Barbell Squat"
        ],
        "notas": "Feet lower on the platform for more quad focus. Get as deep as you can without excessive back rounding."
      },
      {
        "id": "standing_calf_raise_lower2",
        "ejercicio": "Standing Calf Raise",
        "series_calentamiento": "0-1",
        "series_trabajo": 2,
        "repeticiones": "8-10",
        "descanso": "1-2 min",
        "sustituciones_recomendadas": [
