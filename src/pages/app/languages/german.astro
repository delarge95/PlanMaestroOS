---
import PlanMaestroLayout from '../../../layouts/PlanMaestroLayout.astro';
import LessonView from '../../../components/languages/LessonView.tsx';
import VocabularySession from '../../../components/languages/VocabularySession.tsx';
import SpeakingPractice from '../../../components/languages/SpeakingPractice.tsx';
import { germanCourse } from '../../../data/languages/germanCourse.ts';
import Button from '../../../components/ui/Button.tsx';
---

<PlanMaestroLayout title="Alemán A1/A2" activeDomain="languages">
  <div style="display: flex; flex-direction: column; gap: var(--space-md); max-width: 850px; margin: 0 auto; width: 100%;">
    <div style="display: flex; justify-content: space-between; items-center; border-bottom: 1px solid var(--color-border-subtle); padding-bottom: var(--space-xs);">
      <div>
        <h1 style="font-size: 1.4rem; font-weight: 800; margin: 0; color: var(--text);">
          🇩🇪 Alemán A1 / A2
        </h1>
        <span style="font-size: 0.78rem; color: var(--text-tertiary);">
          Teoría clásica, vocabulario & speaking
        </span>
      </div>

      <a href="/app/languages" style="text-decoration: none;">
        <Button variant="ghost" size="sm">Volver a Idiomas</Button>
      </a>
    </div>

    {germanCourse.units[0]?.lessons[0] && (
      <LessonView client:load lesson={germanCourse.units[0].lessons[0]} />
    )}

    <VocabularySession client:load language="de" />
    <SpeakingPractice client:load language="de" />
  </div>
</PlanMaestroLayout>
