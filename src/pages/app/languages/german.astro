---
import PlanMaestroLayout from '../../../layouts/PlanMaestroLayout.astro';
import GermanCourseView from '../../../components/languages/german/GermanCourseView.tsx';
import Button from '../../../components/ui/Button.tsx';
---

<PlanMaestroLayout title="Idiomas — Alemán" activeDomain="languages">
  <div style="display: flex; flex-direction: column; gap: var(--space-md); max-width: 850px; margin: 0 auto; width: 100%;">
    <div style="display: flex; justify-content: space-between; items-center; border-bottom: 1px solid var(--color-border-subtle); padding-bottom: var(--space-xs);">
      <div>
        <h1 style="font-size: 1.4rem; font-weight: 800; margin: 0; color: var(--text);">
          🇩🇪 Alemán A1.1
        </h1>
        <span style="font-size: 0.78rem; color: var(--text-tertiary);">
          Currículo por unidades · SM-2 · nivelación inicial
        </span>
      </div>

      <a href="/app/languages" style="text-decoration: none;">
        <Button variant="ghost" size="sm">Volver a Idiomas</Button>
      </a>
    </div>

    <GermanCourseView client:load />
  </div>
</PlanMaestroLayout>
