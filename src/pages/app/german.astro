---
import PlanMaestroLayout from '../../layouts/PlanMaestroLayout.astro';
import GermanLearningHub from '../../components/german/GermanLearningHub.tsx';
import DomainDocAccordion from '../../components/docs/DomainDocAccordion.tsx';

const germanDocsList = [
  { name: 'plan_maestro_v3.md#modulo-aleman', type: 'Markdown', path: 'plan_maestro_v3.md', description: 'Definición formal del hábito de Alemán diario' },
  { name: '05_language_strategy_and_roi.md', type: 'Markdown', path: '05_language_strategy_and_roi.md', description: 'Estrategia de idiomas (Alemán e Inglés) y ROI laboral en la UE' }
];
---

<PlanMaestroLayout title="Dominio Idiomas (Alemán A1)" activeDomain="german" activePhase="fase-1">
  <div class="german-shell">

    <!-- SUITE INTERACTIVA DEL HÁBITO DIARIO DE ALEMÁN -->
    <GermanLearningHub client:load />

    <div class="german-cards-grid">
      <div class="g-card">
        <span class="g-icon">📱</span>
        <h3>1. Duolingo (5 min)</h3>
        <p>Mantenimiento de racha diaria, vocabulario rápido y fijación de palabras básicas.</p>
        <div class="g-tag">Racha Objetivo: 365 Días</div>
      </div>

      <div class="g-card">
        <span class="g-icon">📚</span>
        <h3>2. Libros A1 + Audios (15-20 min)</h3>
        <p>Set de libros descargados (Menschen A1 / Grammatik aktiv) siguiendo audios oficiales nativos.</p>
        <div class="g-tag">Escucha Activa & Repetición</div>
      </div>

      <div class="g-card">
        <span class="g-icon">🤖</span>
        <h3>3. IA Conversacional (5-10 min)</h3>
        <p>Micro-prácticas con ChatGPT / IA de voz en alemán básico A1 con corrección gramatical inmediata.</p>
        <div class="g-tag">Expresión Hablada & Chat</div>
      </div>
    </div>

    <!-- ACCORDEÓN DOCUMENTOS FUENTE -->
    <DomainDocAccordion
      client:load
      domainTitle="Alemán & Estrategia Lingüística"
      domainColor="#f59e0b"
      categoryFilter="german"
      sourceDocsList={germanDocsList}
    />
  </div>

  <style>
    .german-shell {
      display: flex;
      flex-direction: column;
      gap: 28px;
    }
    .german-cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 20px;
    }
    .g-card {
      background: #080c0e;
      border: 1px solid rgba(245,158,11,0.2);
      border-top: 3px solid #f59e0b;
      border-radius: 12px;
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .g-icon {
      font-size: 1.8rem;
    }
    .g-card h3 {
      font-size: 1.1rem;
      color: #effff6;
      margin: 0;
    }
    .g-card p {
      font-size: 0.84rem;
      color: #a8b9b2;
      margin: 0;
      line-height: 1.5;
      flex: 1;
    }
    .g-tag {
      font-family: 'Azeret Mono', monospace;
      font-size: 0.68rem;
      color: #f59e0b;
      background: rgba(245,158,11,0.12);
      padding: 4px 8px;
      border-radius: 4px;
      margin-top: 10px;
      align-self: flex-start;
      font-weight: 700;
    }
  </style>
</PlanMaestroLayout>
