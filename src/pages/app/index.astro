---
import PlanMaestroLayout from '../../layouts/PlanMaestroLayout.astro';
import HomeClinicalDashboard from '../../components/clinical/HomeClinicalDashboard.tsx';
---

<PlanMaestroLayout title="Plan Activo de Hoy" activeDomain="general" activePhase="fase-1">
  <div class="dashboard-wrapper">

    <!-- PANEL CLINICO CENTRAL "AHORA" + MODO FOCO + BOTÓN DE RESCATE -->
    <HomeClinicalDashboard client:load />

    <!-- ACCESO SECUNDARIO A SECCIONES (NO COMPITE CON LA EJECUCIÓN) -->
    <div class="secondary-nav-section">
      <span class="section-label">Acceso Secundario — Explorar cuando no estás en un bloque activo</span>
      <div class="domains-grid">
        <a href="/app/today" class="domain-card" style="--d-color: var(--color-accent-primary)">
          <span class="d-icon">⚡</span>
          <h4>Centro Operativo Hoy</h4>
          <p>Línea temporal del día. Seguimiento del bloque activo en curso.</p>
        </a>
        <a href="/app/schedules" class="domain-card" style="--d-color: var(--color-accent-primary)">
          <span class="d-icon">📅</span>
          <h4>Cronograma y Matriz</h4>
          <p>Matriz semanal de los 19 bloques por fase. Fases 1, 2 y 3.</p>
        </a>
        <a href="/app/career" class="domain-card" style="--d-color: var(--color-accent-primary)">
          <span class="d-icon">🚀</span>
          <h4>Laboral & Roadmap</h4>
          <p>TwinSight, Portfolio, Roadmap de 16 semanas. Siguiente entregable cerrable.</p>
        </a>
        <a href="/app/fitness" class="domain-card" style="--d-color: var(--color-state-done)">
          <span class="d-icon">💪</span>
          <h4>Fitness</h4>
          <p>Min-Max Nippard (12 sem), Calistenia & Anillas. Rutina según el día.</p>
        </a>
        <a href="/app/german" class="domain-card" style="--d-color: var(--color-accent-warning)">
          <span class="d-icon">🇩🇪</span>
          <h4>Alemán</h4>
          <p>Hábito diario 13:30–14:00. Duolingo + Libros A1 + IA conversacional.</p>
        </a>
        <a href="/app/clinical" class="domain-card" style="--d-color: var(--color-accent-primary)">
          <span class="d-icon">🧠</span>
          <h4>Clínica</h4>
          <p>Módulos TDAH A-F, Ansiedad Social 9 Niveles, Sueño CBT-I.</p>
        </a>
        <a href="/app/library" class="domain-card library-note" style="--d-color: var(--color-accent-primary)">
          <span class="d-icon">📖</span>
          <h4>Biblioteca</h4>
          <p>Base documental de apoyo. <em>Consulta solo si desbloquea una acción concreta de hoy.</em></p>
        </a>
      </div>
    </div>

  </div>

  <style>
    .dashboard-wrapper {
      display: flex;
      flex-direction: column;
      gap: 32px;
    }
    .secondary-nav-section {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .section-label {
      font-family: 'Azeret Mono', monospace;
      font-size: 0.68rem;
      color: #65756f;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      padding-top: 14px;
    }
    .domains-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 14px;
    }
    .domain-card {
      background: rgba(0, 0, 0, 0.25);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-top: 2px solid var(--d-color);
      border-radius: 16px;
      padding: 18px;
      text-decoration: none;
      transition: all 150ms ease;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .domain-card:hover {
      background: rgba(255, 255, 255, 0.04);
      transform: translateY(-2px);
      border-color: var(--d-color);
    }
    .d-icon {
      font-size: 1.4rem;
    }
    .domain-card h4 {
      font-size: 0.95rem;
      color: #effff6;
      margin: 2px 0 0;
      font-weight: 700;
    }
    .domain-card p {
      font-size: 0.78rem;
      color: #65756f;
      margin: 0;
      line-height: 1.4;
    }
    .library-note p em {
      color: #f87171;
      font-style: normal;
      font-size: 0.72rem;
    }
  </style>
</PlanMaestroLayout>
