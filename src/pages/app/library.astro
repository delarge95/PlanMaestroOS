---
import PlanMaestroLayout from '../../layouts/PlanMaestroLayout.astro';
import LibraryPage from '../../components/library/LibraryPage.tsx';
---

<PlanMaestroLayout title="Biblioteca" activeDomain="library" breadcrumb="Más / Biblioteca">
  <div class="library-shell">
    <LibraryPage client:load />
  </div>

  <style>
    .library-shell {
      display: flex;
      flex-direction: column;
      gap: 16px;
      width: 100%;
    }
  </style>
</PlanMaestroLayout>
