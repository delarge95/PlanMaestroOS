---
import PlanMaestroLayout from '../../layouts/PlanMaestroLayout.astro';
import InteractiveDocViewer from '../../components/docs/InteractiveDocViewer.tsx';
import NotionObsidianIntegrationHub from '../../components/docs/NotionObsidianIntegrationHub.tsx';
import SecondBrainInspector from '../../components/docs/SecondBrainInspector.tsx';
---

<PlanMaestroLayout title="Biblioteca & Buscador RAG" activeDomain="library" activePhase="fase-1">
  <div class="library-shell">
    <div class="lib-header">
      <span class="lib-badge">SEGUNDO CEREBRO • ALMÁCIGO DE HECHOS VERIFICADOS</span>
      <h2>Explorador de Conocimiento & Trazabilidad de Fuentes</h2>
      <p>
        Buscador semántico en tiempo real sobre los 47 documentos de auditoría laboral, los 3 libros de entrenamiento PDF (*Overcoming Gravity*, *Overcoming Tendonitis*, *The Min-Max Program*), los reportes clínicos y la biblia de carrera.
      </p>
    </div>

    <!-- INSPECTOR EN VIVO DEL SEGUNDO CEREBRO (NOTION EMBED & REINTERPRETED CHARTS) -->
    <SecondBrainInspector client:load />

    <!-- HUB DE INTEGRACIÓN CON OBSIDIAN Y NOTION -->
    <NotionObsidianIntegrationHub client:load />

    <!-- BUSCADOR RAG Y NAVEGADOR DE DOCUMENTOS -->
    <InteractiveDocViewer client:load />
  </div>

  <style>
    .library-shell {
      display: flex;
      flex-direction: column;
      gap: 28px;
    }
    .lib-header {
      background: rgba(12, 14, 18, 0.75);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 20px;
      padding: 24px;
      backdrop-filter: blur(40px);
    }
    .lib-badge {
      font-family: -apple-system, SF Pro Text, sans-serif;
      font-size: 0.72rem;
      color: #bf5af2;
      font-weight: 700;
      letter-spacing: 0.04em;
    }
    .lib-header h2 {
      font-size: 1.5rem;
      color: #ffffff;
      margin: 6px 0;
    }
    .lib-header p {
      color: #98989d;
      font-size: 0.88rem;
      margin: 0;
      line-height: 1.5;
    }
  </style>
</PlanMaestroLayout>
