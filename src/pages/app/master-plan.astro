---
import PlanMaestroLayout from '../../layouts/PlanMaestroLayout.astro';
const germanModule = {
  schedule: '13:30 - 14:00',
  components: [
    { name: 'Duolingo A1', duration: '5 min', objective: 'Calentamiento diario' },
    { name: 'Libro A1 / Gramática', duration: '20 min', objective: 'Estudio guiado' }
  ]
};
---

<PlanMaestroLayout title="Plan Maestro Total OS v3" activeDomain="general" activePhase="fase-1">
  <div class="mp-container">
    <div class="mp-header">
      <span class="mp-badge">DOCUMENTACIÓN MAESTRA DE OPERACIÓN v3</span>
      <h2>Plan Maestro Total OS</h2>
      <p>
        Arquitectura integral de trabajo personal de Alexander Woodcock Salomon. Integración de Carrera (Unity/TwinSight), 
        Clínica TDAH & Ansiedad Social, Fitness y Hábito de Alemán.
      </p>
    </div>

    <div class="mp-grid">
      <div class="mp-card">
        <h3>1. Directrices Clínicas Guía</h3>
        <ul>
          <li><strong>Suficientemente Terminado > Ideal:</strong> Cerrar entregables con criterio mínimo sin sobre-refinar.</li>
          <li><strong>No trabajar desde voluntad pura:</strong> El sistema depende de arquitectura externa (Agenda única, 3 tareas/día).</li>
          <li><strong>25 horas útiles semanales:</strong> El roadmap laboral está diseñado para 25h/sem real, no 60h imaginarias.</li>
          <li><strong>Alemán a paso lento pero seguro:</strong> 20 a 35 min diarios (lunes a domingo) sostenidos sin romper el hábito.</li>
        </ul>
      </div>

      <div class="mp-card german-card">
        <h3>2. Módulo de Alemán (v3)</h3>
        <p><strong>Ubicación fija:</strong> {germanModule.schedule}</p>
        <div class="german-steps">
          {germanModule.components?.map((c: any, i: number) => (
            <div class="g-step">
              <span class="g-num">{i + 1}</span>
              <div>
                <strong>{c.name} ({c.duration})</strong>
                <small>{c.objective}</small>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <style>
    .mp-container {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }
    .mp-header {
      background: var(--color-surface-base);
      border: 1px solid var(--color-border-visible);
      border-radius: 20px;
      padding: 24px;
      backdrop-filter: blur(40px);
    }
    .mp-badge {
      font-family: -apple-system, SF Pro Text, sans-serif;
      font-size: 0.72rem;
      color: var(--color-accent-primary);
      font-weight: 700;
    }
    .mp-header h2 {
      font-size: 1.5rem;
      color: var(--color-text-primary);
      margin: 6px 0;
    }
    .mp-header p {
      color: var(--color-text-secondary);
      font-size: 0.88rem;
      margin: 0;
      line-height: 1.5;
    }
    .mp-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 20px;
    }
    .mp-card {
      background: var(--color-surface-base);
      border: 1px solid var(--color-border-subtle);
      border-top: 3px solid var(--color-accent-primary);
      border-radius: 18px;
      padding: 20px;
    }
    .german-card {
      border-top-color: var(--color-accent-warning) !important;
    }
    .german-card h3 {
      color: var(--color-accent-warning) !important;
    }
    .mp-card h3 {
      font-size: 1.1rem;
      margin: 0 0 14px;
      color: var(--color-text-primary);
    }
    .mp-card ul {
      margin: 0;
      padding-left: 18px;
      color: var(--color-text-secondary);
      font-size: 0.85rem;
      line-height: 1.6;
    }
    .german-steps {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-top: 12px;
    }
    .g-step {
      display: flex;
      align-items: center;
      gap: 12px;
      background: rgba(0,0,0,0.3);
      padding: 10px;
      border-radius: 8px;
      border: 1px solid var(--color-border-subtle);
    }
    .g-num {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: var(--color-accent-warning);
      color: #000000;
      font-weight: 700;
      font-size: 0.75rem;
      display: grid;
      place-items: center;
    }
    .g-step strong {
      display: block;
      font-size: 0.85rem;
      color: var(--color-text-primary);
    }
    .g-step small {
      color: var(--color-text-secondary);
      font-size: 0.75rem;
    }
  </style>
</PlanMaestroLayout>
