---
/*
 * Portafolio público — index.astro
 * Arquitectura: Hero WebGL (PortfolioHero) → Selected Work scrollytelling
 * (ProjectShowcase) → SphericalGallery (funcionalidad consolidada, intacta)
 * → Services (ServicesGrid → cotizador) → PortfolioFooter.
 * Todo lo que no es above-the-fold va con client:visible. El 3D no bloquea
 * el primer paint: el texto del hero es SSR y el canvas es una isla lazy.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import PortfolioFooter from "@components/portfolio/PortfolioFooter.astro";
import PortfolioHero from "@components/portfolio/PortfolioHero";
import ProjectShowcase from "@components/portfolio/ProjectShowcase";
import ServicesGrid from "@components/portfolio/ServicesGrid";
import SphericalGallery from "@components/SphericalGallery";
import { galleryItems, projects } from "@data/projects";
import "../styles/portfolio.css";
---

<BaseLayout
  title="Real-Time 3D Developer / Unity Technical Artist"
  description="Portfolio of Alexander Woodcock — Unity WebGL technical visualization, CAD-to-realtime optimization and Blender 3D pipeline craft. Interactive drone-inspection digital twin, character pipeline and Python automation."
>
  {/* Marca JS antes del CSS de reveals: sin JS todo queda visible */}
  <script is:inline>
    document.documentElement.classList.add("pf-js");
  </script>

  {/* 1 · HERO — WebGL full-screen, partículas que responden al mouse */}
  <PortfolioHero client:visible />

  {/* 2 · SELECTED WORK — scrollytelling: TwinSight → Human → ARA */}
  <ProjectShowcase projects={projects} initialId="twinsight" client:visible />

  {/* Interludio · órbita 3D (galería consolidada — API items intacta) */}
  <SphericalGallery items={galleryItems} client:visible />

  {/* 3 · SERVICES — 5 cards + CTA al cotizador desplegado */}
  <ServicesGrid client:visible />

  {/* 4 · FOOTER — disponibilidad + links + idioma */}
  <PortfolioFooter />
</BaseLayout>

<script>
  /*
   * Orquestación de la página: i18n (siteLang), reveals con
   * IntersectionObserver + transforms CSS, parallax sutil en métricas
   * y cursor custom (dot + ring, difference) solo en desktop puntero fino.
   * TODO respeta prefers-reduced-motion.
   */
  import "../scripts/siteLang";

  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  /* ── Reveals: IO + clase .is-inview (transitions en portfolio.css) ── */
  const initReveals = () => {
    const elements = Array.from(document.querySelectorAll<HTMLElement>("[data-pf-reveal]"));

    /* stagger: grupos con data-pf-stagger reparten --pf-delay entre hijos */
    document.querySelectorAll<HTMLElement>("[data-pf-stagger]").forEach((group) => {
      Array.from(group.querySelectorAll<HTMLElement>("[data-pf-reveal]")).forEach((child, index) => {
        child.style.setProperty("--pf-delay", `${Math.min(index * 70, 280)}ms`);
      });
    });

    if (reduced) {
      elements.forEach((element) => element.classList.add("is-inview"));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-inview");
          observer.unobserve(entry.target);
        });
      },
      { rootMargin: "0px 0px -8% 0px", threshold: 0.12 }
    );

    elements.forEach((element) => observer.observe(element));

    /* red de seguridad: al llegar al final del documento revela lo que
       haya quedado dentro de la zona muerta del rootMargin inferior */
    const revealAll = () => {
      if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 160) {
        elements.forEach((element) => element.classList.add("is-inview"));
        window.removeEventListener("scroll", revealAll);
      }
    };
    window.addEventListener("scroll", revealAll, { passive: true });
  };

  /* ── Parallax sutil en métricas (±14px, rAF sobre scroll) ── */
  const initParallax = () => {
    const elements = Array.from(document.querySelectorAll<HTMLElement>("[data-pf-parallax]"));
    if (!elements.length || reduced) return;

    let ticking = false;
    const update = () => {
      const viewport = window.innerHeight;
      for (const element of elements) {
        const rect = element.getBoundingClientRect();
        if (rect.bottom < -80 || rect.top > viewport + 80) continue;
        const center = rect.top + rect.height / 2;
        const ratio = (center - viewport / 2) / viewport; /* -1..1 */
        element.style.transform = `translate3d(0, ${(ratio * -14).toFixed(1)}px, 0)`;
      }
      ticking = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          window.requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true }
    );
    update();
  };

  /* ── Cursor custom: dot + ring con mix-blend difference (solo desktop) ── */
  const initCursor = () => {
    const fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
    if (!fine || window.innerWidth < 900) return;

    const dot = document.createElement("div");
    const ring = document.createElement("div");
    dot.className = "pf-cursor-dot";
    ring.className = "pf-cursor-ring";
    dot.setAttribute("aria-hidden", "true");
    ring.setAttribute("aria-hidden", "true");
    document.body.append(dot, ring);
    document.body.classList.add("pf-cursor-on");

    let x = window.innerWidth / 2;
    let y = window.innerHeight / 2;
    let ringX = x;
    let ringY = y;
    let pressScale = 1;

    const render = () => {
      window.requestAnimationFrame(render);
      dot.style.transform = `translate3d(${x}px, ${y}px, 0) scale(${pressScale})`;
      /* reduced-motion: el anillo sigue instantáneo (sin lerp) */
      if (reduced) {
        ringX = x;
        ringY = y;
      } else {
        ringX += (x - ringX) * 0.16;
        ringY += (y - ringY) * 0.16;
      }
      ring.style.transform = `translate3d(${ringX.toFixed(1)}px, ${ringY.toFixed(1)}px, 0)`;
    };

    const onPointerMove = (event: PointerEvent) => {
      if (event.pointerType !== "mouse") return;
      x = event.clientX;
      y = event.clientY;
    };

    /* estado "hot" sobre interactivos → el anillo crece (CSS) */
    const onPointerOver = (event: PointerEvent) => {
      const target = event.target instanceof Element ? event.target : null;
      const hot = Boolean(target?.closest("a, button, [role='button'], input, select, textarea"));
      document.body.classList.toggle("pf-cursor-hot", hot);
    };

    const onPointerDown = () => {
      pressScale = 1.8;
    };

    const onPointerUp = () => {
      pressScale = 1;
    };

    const onLeave = () => document.body.classList.remove("pf-cursor-on");
    const onEnter = () => document.body.classList.add("pf-cursor-on");

    window.addEventListener("pointermove", onPointerMove, { passive: true });
    window.addEventListener("pointerover", onPointerOver, { passive: true });
    window.addEventListener("pointerdown", onPointerDown, { passive: true });
    window.addEventListener("pointerup", onPointerUp, { passive: true });
    document.documentElement.addEventListener("mouseleave", onLeave);
    document.documentElement.addEventListener("mouseenter", onEnter);

    render();
  };

  initReveals();
  initParallax();
  initCursor();
</script>
