---
import CTAButton from "@components/CTAButton.astro";
import ProjectCard from "@components/ProjectCard.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { focusVariants } from "@data/focusVariants";
import { projects } from "@data/projects";
---

<BaseLayout
  title="Work"
  description="Selected work by Alexander Woodcock Salomon: TwinSight X500, Human character pipeline and ARA Framework."
>
  <section class="page-shell case-hero">
    <div class="case-hero-copy">
      <p class="eyebrow">Selected work / 3 projects</p>
      <h1>Selected systems for real-time 3D work.</h1>
      <p class="hero-copy">
        Three projects are shown deliberately: TwinSight as the flagship, Human as the 3D pipeline pillar, and ARA as a supporting automation system.
      </p>
    </div>
  </section>

  <section class="section-shell">
    <div class="project-grid">
      {projects.map((project, index) => <ProjectCard project={project} featured={index < 2} />)}
    </div>
  </section>

  <section class="section-shell">
    <div class="section-intro">
      <div>
        <p class="eyebrow">Focus routes</p>
        <h2>Same work, sorted per application path.</h2>
      </div>
      <p>
        Each route reorders these projects for a specific role family. The facts stay consistent.
      </p>
    </div>
    <div class="hero-actions">
      {focusVariants.map((variant) => (
        <CTAButton href={`/focus/${variant.slug}`} label={variant.label} variant="ghost" />
      ))}
    </div>
  </section>
</BaseLayout>
