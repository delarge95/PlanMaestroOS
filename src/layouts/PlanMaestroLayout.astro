---
import '../styles/global.css';
import NavigationShell from '../components/navigation/NavigationShell.tsx';
import SectionNavBar from '../components/shell/SectionNavBar.astro';
import styles from '../components/navigation/NavigationShell.module.css';

interface Props {
  title: string;
  pageTitle?: string;
  activeDomain?: 'now' | 'plan' | 'more' | 'clinical' | 'career' | 'german' | 'languages' | 'gastronomy' | 'fitness' | 'library' | 'master-plan' | 'general' | 'schedules' | 'today';
  activePhase?: 'fase-1' | 'fase-2' | 'fase-3';
  breadcrumb?: string;
}

const { title, pageTitle, activeDomain = 'now', activePhase = 'fase-1', breadcrumb } = Astro.props;

// Map legacy domains to NavigationShell domains
const mappedDomain = (activeDomain === 'general' || activeDomain === 'today')
  ? 'now'
  : activeDomain === 'schedules'
  ? 'plan'
  : activeDomain;

// Nivel 3 (subsecciones) — se renderiza DESPUÉS del h1, dentro del contenedor de contenido.
import { SECTION_NAV } from '../components/shell/sectionNavConfig';

function detectLevel3(path: string): string | null {
  if (/^\/app\/fitness\/library/.test(path)) return 'fitness.library';
  return null;
}

const l3Key = detectLevel3(Astro.url.pathname);
const l3Items = l3Key ? SECTION_NAV[l3Key] : undefined;
const l3Exact = l3Items?.find(i => i.end && Astro.url.pathname === i.href);
const l3Prefix = l3Items?.find(i => !i.end && Astro.url.pathname.startsWith(i.href));
const l3ActiveFinal = (l3Exact ?? l3Prefix ?? l3Items?.find(i => i.end)?.href ?? l3Items?.[0]?.href) ?? '';
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Plan Maestro OS</title>
    <meta name="description" content="Sistema Operativo Personal Interactivo, Trazable y Multi-Dominio de Alexander Woodcock" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="app-body">
    <div class={styles.wrapper}>
      <NavigationShell client:load currentPath={Astro.url.pathname} activeDomain={mappedDomain} breadcrumb={breadcrumb} />
      <SectionNavBar />

      <main class={styles.appMain} id="app-main">
        {pageTitle && (
          <h1 style="font: 700 clamp(1.5rem, 3vw, 2.25rem) var(--font-family-system); letter-spacing: -0.02em; color: var(--text-primary); margin: 0 0 var(--space-3); line-height: 1.15;">{pageTitle}</h1>
        )}

        {l3Items && l3Items.length > 0 && (
          <nav class="snb-l3" aria-label="Navegación de subsección" style="margin: 0 0 var(--space-4);">
            {l3Items.map(item => (
              <a
                href={item.href}
                class:list={['snb-l3-link', { 'snb-l3-link-active': item.href === l3ActiveFinal }]}
                aria-current={item.href === l3ActiveFinal ? 'page' : undefined}
              >{item.label}</a>
            ))}
          </nav>
        )}

        <slot />
      </main>
    </div>

    <style>
      .app-body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--text);
        font-family: var(--font-family-system);
        min-height: 100vh;
      }
    </style>

    <!-- GLOBAL ERROR CATCHER FOR DEBUGGING -->
    <script>
      window.onerror = function(message, source, lineno, colno, error) {
        const errDiv = document.createElement('div');
        errDiv.style.position = 'fixed';
        errDiv.style.bottom = '20px';
        errDiv.style.left = '20px';
        errDiv.style.right = '20px';
        errDiv.style.padding = '20px';
        errDiv.style.background = 'var(--color-accent-danger)';
        errDiv.style.color = 'var(--color-text-primary)';
        errDiv.style.zIndex = '999999';
        errDiv.style.borderRadius = '8px';
        errDiv.style.boxShadow = '0 10px 25px rgba(0,0,0,0.5)';
        errDiv.style.fontFamily = 'monospace';
        errDiv.innerHTML = `<strong>GLOBAL ERROR:</strong> ${message}<br><small>${source}:${lineno}:${colno}</small><br><pre style="white-space:pre-wrap;font-size:10px;margin-top:10px;">${error ? error.stack : ''}</pre>`;
        document.body.appendChild(errDiv);
        return false;
      };
    </script>
  </body>
</html>
