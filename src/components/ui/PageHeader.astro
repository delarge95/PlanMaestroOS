---
// src/components/ui/PageHeader.astro
interface Props {
  title: string;
  eyebrow?: string;
  meta?: string;
}

const { title, eyebrow, meta } = Astro.props;
---

<header class="page-header-ui">
  {eyebrow && <span class="eyebrow-text">{eyebrow}</span>}
  <h1 class="page-header-title">{title}</h1>
  {meta && <p class="meta-text">{meta}</p>}
  <slot />
</header>

<style>
  .page-header-ui {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-bottom: var(--space-5);
  }

  .eyebrow-text {
    font-size: var(--fs-eyebrow, 0.75rem);
    font-weight: 700;
    color: var(--accent, #0a84ff);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .page-header-title {
    font-size: var(--fs-page, 1.75rem);
    font-weight: 700;
    color: var(--text-primary, #f5f5f7);
    line-height: 1.2;
    margin: 0;
  }

  .meta-text {
    font-size: var(--fs-meta, 0.8125rem);
    color: var(--text-secondary, #98989d);
    margin: 0;
  }
</style>
