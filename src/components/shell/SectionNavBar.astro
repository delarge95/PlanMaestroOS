---
// SectionNavBar.astro — Nivel 2: pill chips sticky arriba. SIEMPRE lo primero bajo el NavigationShell.
// El nivel 3 (subsecciones) lo renderiza PlanMaestroLayout DESPUÉS del h1, dentro del contenedor de contenido.
import { SECTION_NAV } from '../shell/sectionNavConfig';

interface Props {
  sectionKey?: string;
}

const { sectionKey: overrideKey } = Astro.props;
const pathname = Astro.url.pathname;

function detectSection(path: string): string | null {
  if (/^\/app\/fitness\/library/.test(path)) return 'fitness';
  if (/^\/app\/fitness/.test(path)) return 'fitness';
  if (/^\/app\/career/.test(path)) return 'career';
  if (/^\/app\/clinical/.test(path)) return 'clinical';
  if (/^\/app\/languages/.test(path)) return 'languages';
  if (/^\/app\/gastronomy/.test(path)) return 'gastronomy';
  if (/^\/app\/schedules|^\/app\/today/.test(path)) return 'today';
  return null;
}

const key = overrideKey ?? detectSection(pathname);
const l2Items = key ? SECTION_NAV[key] : undefined;

function activeHref(items: typeof l2Items, path: string): string {
  if (!items) return '';
  const exact = items.find(i => i.end && path === i.href);
  if (exact) return exact.href;
  const prefix = items.find(i => !i.end && path.startsWith(i.href));
  if (prefix) return prefix.href;
  return items.find(i => i.end)?.href ?? '';
}

const l2Active = activeHref(l2Items, pathname);
---

{l2Items && l2Items.length > 0 && (
  <div class="snb-wrap">
    <nav class="snb-l2" aria-label="Navegación de sección">
      {l2Items.map(item => (
        <a
          href={item.href}
          class:list={['snb-pill', { 'snb-pill-active': item.href === l2Active }]}
          aria-current={item.href === l2Active ? 'page' : undefined}
        >{item.label}</a>
      ))}
    </nav>
  </div>
)}
