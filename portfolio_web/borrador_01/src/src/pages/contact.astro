---
import CTAButton from "@components/CTAButton.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { isPlaceholderLink, links } from "@data/links";

const contactLinks = [
  ["Email", links.email],
  ["LinkedIn", links.linkedIn],
  ["GitHub", links.githubProfile],
  ["ArtStation", links.artStation],
  ["CV", links.cv]
];

const hasEmail = !isPlaceholderLink(links.email);
const emailHref = hasEmail ? links.email : "";
const mailAction = hasEmail ? links.email : "";
---

<BaseLayout
  title="Contact"
  description="Contact Alexander Woodcock Salomon for remote Unity WebGL, technical visualization and technical art opportunities."
>
  <section class="page-shell contact-hero">
    <div class="case-hero-copy">
      <p class="eyebrow" data-scramble="Contact / remote work">Contact / remote work</p>
      <h1>Remote technical 3D work from Colombia.</h1>
      <p class="hero-copy">
        Best-fit conversations: Unity WebGL, interactive 3D, technical visualization, Unity Technical Artist roles, Blender pipeline work and Python-assisted technical tooling.
      </p>
      <div class="contact-actions">
        {hasEmail ? <CTAButton href={emailHref} label="Email directly" /> : <CTAButton href={links.linkedIn} label="Message on LinkedIn" />}
        <CTAButton href={links.linkedIn} label="LinkedIn" variant="secondary" />
        <CTAButton href={links.cv} label="Download CV" variant="ghost" />
      </div>
    </div>

    <aside class="contact-status" data-reveal>
      <span>Availability</span>
      <strong>Open to remote contractor / B2B work</strong>
      <p>Unity WebGL, realtime 3D, product visualization and technical art support.</p>
    </aside>
  </section>

  <section class="section-shell contact-grid">
    <form class="contact-form" action={mailAction} method="post" enctype="text/plain" data-reveal>
      <p class="eyebrow">Direct inquiry</p>
      <h2>Send a concise project brief.</h2>
      <label>
        <span>Name / company</span>
        <input name="name" type="text" autocomplete="name" placeholder="Studio, recruiter or team" />
      </label>
      <label>
        <span>Role / project</span>
        <input name="project" type="text" placeholder="Unity WebGL, technical art, visualization..." />
      </label>
      <label>
        <span>Message</span>
        <textarea name="message" rows="5" placeholder="What are you building, what do you need, and what timeline are you considering?"></textarea>
      </label>
      <button class="cta-button cta-primary" type="submit" disabled={!hasEmail}>
        {hasEmail ? "Prepare email" : "Email pending"}
        <span class="cta-arrow">-></span>
      </button>
      {!hasEmail && <p class="form-note">Replace [EMAIL] in the site data to activate direct email submission.</p>}
    </form>

    <aside class="contact-panel" data-reveal>
      <p class="eyebrow">Public links</p>
      <div class="link-table">
        {contactLinks.map(([label, href]) =>
          isPlaceholderLink(href) ? (
            <span><strong>{label}</strong><em>{href}</em></span>
          ) : (
            <a href={href}><strong>{label}</strong><em>{href}</em></a>
          )
        )}
      </div>
    </aside>
  </section>
</BaseLayout>
