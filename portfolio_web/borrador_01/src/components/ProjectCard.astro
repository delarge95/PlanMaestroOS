---
import CTAButton from "@components/CTAButton.astro";
import TechTag from "@components/TechTag.astro";
import type { Project } from "@data/projects";

type Props = {
  project: Project;
  featured?: boolean;
};

const { project, featured = false } = Astro.props;
const primaryStack = project.primaryStack ?? project.stack.slice(0, featured ? 4 : 3);
const secondaryStack = project.secondaryStack ?? project.stack.slice(featured ? 4 : 3);
const secondaryAction = project.liveUrl
  ? { href: project.liveUrl, label: "Open WebGL prototype" }
  : project.links[0]
    ? { href: project.links[0].href, label: project.links[0].label }
    : undefined;
---

<article
  class:list={["project-card", featured && "project-featured", `accent-${project.accent}`]}
  data-project-card
  data-project-id={project.id}
  data-project-accent={project.accent}
  data-reveal
>
  <button
    class="project-card-media-button media-frame media-wide"
    type="button"
    data-project-expand
    aria-label={`Expand ${project.title} project card`}
  >
    <img src={project.media} alt={project.mediaAlt} loading="lazy" decoding="async" />
    <span class="project-media-caption">{project.galleryRole}</span>
  </button>
  <div class="project-card-body">
    <p class="eyebrow">{project.eyebrow}</p>
    <h3>{project.title}</h3>
    <p class="project-subtitle">{project.subtitle}</p>
    <p>{project.summary}</p>
    <div class="tag-row project-primary-stack" aria-label={`${project.title} primary stack`}>
      {primaryStack.map((tag) => <TechTag label={tag} tone={project.accent} />)}
    </div>
    <div class="tag-row project-secondary-stack" aria-label={`${project.title} supporting stack`}>
      {secondaryStack.map((tag) => <TechTag label={tag} tone={project.accent} />)}
    </div>
    <div class="project-card-extra">
      <p><strong>Signal:</strong> {project.proof}</p>
      <p><strong>Role:</strong> {project.role}</p>
      <p>{project.interactionNotes}</p>
      {project.statusNote && <p class="project-card-note">{project.statusNote}</p>}
    </div>
    <div class="card-actions">
      <CTAButton href={project.caseStudyUrl} label="View case study" variant="primary" />
      {secondaryAction && <CTAButton href={secondaryAction.href} label={secondaryAction.label} variant="ghost" />}
    </div>
  </div>
</article>
