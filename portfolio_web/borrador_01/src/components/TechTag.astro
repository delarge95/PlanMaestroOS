---
type Props = {
  label: string;
  tone?: "default" | "cyan" | "warm" | "green";
};

const { label, tone = "default" } = Astro.props;
---

<button
  class:list={["tech-tag", `tag-${tone}`]}
  type="button"
  data-tech-tag
  data-tech-label={label}
  aria-expanded="false"
  aria-label={`Show recruiter signal for ${label}`}
>
  {label}
</button>
