---
type Props = {
  src: string;
  alt: string;
  label?: string;
  aspect?: "wide" | "square" | "portrait";
  priority?: boolean;
  hotspots?: {
    x: number;
    y: number;
    width?: number;
    height?: number;
    anchorX?: number;
    anchorY?: number;
    label: string;
    detail: string;
  }[];
};

const { src, alt, label, aspect = "wide", priority = false } = Astro.props;
---

<figure class:list={["media-frame", `media-${aspect}`]} data-reveal>
  <img src={src} alt={alt} loading={priority ? "eager" : "lazy"} decoding="async" />
  {label && <figcaption>{label}</figcaption>}
</figure>
