---
import CTAButton from "@components/CTAButton.astro";
import FocusVariantSwitcher from "@components/FocusVariantSwitcher";
import MediaFrame from "@components/MediaFrame.astro";
import ProjectCard from "@components/ProjectCard.astro";
import SphericalGallery from "@components/SphericalGallery";
import TechTag from "@components/TechTag.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { focusVariants } from "@data/focusVariants";
import { links } from "@data/links";
import { galleryItems, projects } from "@data/projects";

const twinsight = projects.find((project) => project.id === "twinsight")!;
const human = projects.find((project) => project.id === "human")!;
const ara = projects.find((project) => project.id === "ara")!;
const coreStack = ["Unity WebGL", "C#", "Blender", "CAD-to-Realtime", "Technical UI", "Python Tooling"];
---

<BaseLayout
  title="Real-Time 3D Developer / Unity Technical Artist"
  description="Portfolio for Alexander Woodcock Salomon, focused on Unity WebGL technical visualization, CAD-to-realtime optimization and Blender 3D pipeline craft."
>
  <section class="page-shell hero">
    <div class="hero-content">
      <p class="eyebrow" data-scramble="Remote contractor from Colombia">Remote contractor from Colombia</p>
      <h1 class="hero-title" data-animate-title>
        <span>Realtime</span>
        <span>3D Systems</span>
        <span>Unity WebGL</span>
      </h1>
      <p class="hero-copy">
        I build browser-ready 3D tools where interaction logic, asset craft and technical UI meet. TwinSight leads the realtime side. Human shows the production eye behind it.
      </p>
      <div class="tag-row" aria-label="Core stack">
        {coreStack.map((tag) => <TechTag label={tag} tone="cyan" />)}
      </div>
      <div class="hero-actions">
        <CTAButton href="/twinsight-x500" label="View TwinSight X500" />
        <CTAButton href="/human-character-pipeline" label="View Human pipeline" variant="secondary" />
        <CTAButton href={links.githubProfile} label="GitHub" variant="ghost" />
        <CTAButton href="/contact" label="Contact" variant="ghost" />
      </div>
    </div>
    <div class="hero-visual" data-reveal>
      <div class="screen-shell" aria-label="TwinSight X500 interface preview">
        <div class="screen-chrome">
          <span></span>
          <span></span>
          <span></span>
          <small>TWINSIGHT_X500 / WEBGL_VIEWER</small>
        </div>
        <MediaFrame
          src={twinsight.media}
          alt={twinsight.mediaAlt}
          label="Flagship: Unity WebGL technical visualization"
          priority
        />
        <div class="screen-readout" aria-hidden="true">
          <span>Runtime UI</span>
          <span>CAD-to-realtime</span>
          <span>Browser build</span>
        </div>
      </div>
    </div>
  </section>

  <section class="page-shell proof-strip" aria-label="Portfolio evidence summary" data-reveal>
    <div>
      <strong>TwinSight X500</strong>
      <p><b>Unity WebGL</b>, runtime interaction, CAD-to-realtime and formative evaluation.</p>
    </div>
    <div>
      <strong>Human Pipeline</strong>
      <p><b>Blender workflow depth</b>: sculpt, topology, UVs, materials, grooming and render control.</p>
    </div>
    <div>
      <strong>ARA Framework</strong>
      <p><b>Python tooling</b>, research automation and structured technical documentation.</p>
    </div>
    <div>
      <strong>Focus Variants</strong>
      <p>Reusable routes for technical visualization, Unity WebGL, TA and 3D pipeline applications.</p>
    </div>
  </section>

  <SphericalGallery items={galleryItems} client:visible />

  <section class="section-shell sticky-proof-section" aria-label="Main proof systems">
    <div class="sticky-proof-copy" data-reveal>
      <p class="eyebrow">Two anchors</p>
      <h2>Runtime systems. Production craft.</h2>
      <p>
        Keep this read in view while the proof changes: <strong>TwinSight</strong> is the flagship for Unity/WebGL roles. <strong>Human</strong> has real weight as the second pillar because it shows the 3D workflow behind technical-art judgment.
      </p>
      <div class="sticky-proof-readout" aria-hidden="true">
        <span>Realtime viewer</span>
        <span>Asset pipeline</span>
        <span>Recruiter scan</span>
      </div>
    </div>
    <div class="sticky-proof-track">
      <ProjectCard project={twinsight} featured />
      <ProjectCard project={human} featured />
    </div>
  </section>

  <section class="section-shell split-section">
    <div>
      <p class="eyebrow">Application-ready storytelling</p>
      <h2>Same portfolio, different emphasis per role.</h2>
      <p class="section-lead">
        The site is structured as a living portfolio. It can lead with technical visualization, Unity WebGL, technical art, or Blender pipeline depth while keeping the facts consistent.
      </p>
    </div>
    <FocusVariantSwitcher variants={focusVariants} client:load />
  </section>

  <section class="section-shell sticky-proof-section sticky-support-section" aria-label="Supporting automation system">
    <div class="sticky-proof-copy" data-reveal>
      <p class="eyebrow">Supporting system</p>
      <h2>Automation stays useful, not loud.</h2>
      <p>
        ARA adds <strong>Python automation</strong> and AI-assisted workflow range, while the public identity stays centered on Unity, WebGL and 3D pipeline craft.
      </p>
      <div class="sticky-proof-readout" aria-hidden="true">
        <span>Secondary proof</span>
        <span>Tooling signal</span>
        <span>Documentation</span>
      </div>
    </div>
    <div class="sticky-proof-track sticky-proof-track-single">
      <ProjectCard project={ara} />
    </div>
  </section>
</BaseLayout>
