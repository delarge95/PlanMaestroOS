---
import CTAButton from "@components/CTAButton.astro";
import TechTag from "@components/TechTag.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { links } from "@data/links";

const stack = [
  "Unity WebGL",
  "C# runtime systems",
  "Technical UI",
  "Blender pipeline",
  "Topology / UVs",
  "Python tooling",
  "Documentation"
];

const operatingRange = [
  ["Realtime", "Unity WebGL prototypes, interaction states, browser constraints and technical visualization."],
  ["Pipeline", "Blender asset workflow literacy: form, topology, UVs, materials, groom, lighting and render."],
  ["Systems", "Python-assisted tooling, research automation, structured notes and repeatable documentation."]
];

const timeline = [
  ["01", "Multimedia Engineering", "Visual systems, interaction design and technical communication."],
  ["02", "Electronic Engineering coursework", "Signal, systems and engineering discipline applied to 3D/technical work."],
  ["03", "TwinSight X500", "Unity WebGL flagship for CAD-to-realtime technical visualization."],
  ["04", "Human pipeline", "3D workflow study that strengthens technical-art judgment."]
];
---

<BaseLayout
  title="About"
  description="About Alexander Woodcock Salomon, a Real-Time 3D Developer / Unity Technical Artist focused on Unity WebGL, technical visualization and Blender pipeline craft."
>
  <section class="page-shell about-hero">
    <div class="case-hero-copy">
      <p class="eyebrow" data-scramble="About / operating profile">About / operating profile</p>
      <h1>Realtime 3D systems with a production eye.</h1>
      <p class="hero-copy">
        I sit between interactive engineering and visual craft: Unity WebGL for browser-ready tools, Blender for upstream asset judgment, and Python for repeatable technical workflows.
      </p>
      <div class="tag-row">
        {stack.map((skill) => <TechTag label={skill} tone="cyan" />)}
      </div>
      <div class="hero-actions">
        <CTAButton href="/work" label="View work" />
        <CTAButton href="/twinsight-x500" label="TwinSight" variant="secondary" />
        <CTAButton href={links.linkedIn} label="LinkedIn" variant="ghost" />
      </div>
    </div>

    <aside class="identity-panel" data-reveal>
      <div>
        <span>Profile</span>
        <strong>Unity WebGL / Technical Artist</strong>
      </div>
      <div>
        <span>Base</span>
        <strong>Colombia / Remote</strong>
      </div>
      <div>
        <span>Flagship</span>
        <strong>TwinSight X500</strong>
      </div>
      <div>
        <span>Second pillar</span>
        <strong>Human Blender Pipeline</strong>
      </div>
    </aside>
  </section>

  <section class="section-shell">
    <div class="section-intro">
      <div>
        <p class="eyebrow">Operating range</p>
        <h2>Technical, visual, repeatable.</h2>
      </div>
      <p>
        The portfolio is built around evidence: realtime implementation, complete 3D workflow literacy and the ability to explain technical decisions without hiding behind decoration.
      </p>
    </div>

    <div class="signal-board">
      {operatingRange.map(([title, body]) => (
        <article class="signal-card" data-reveal>
          <span>{title}</span>
          <h3>{title}</h3>
          <p>{body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section-shell split-section about-split">
    <div>
      <p class="eyebrow">How I frame the work</p>
      <h2>Useful before it is flashy.</h2>
      <p class="section-lead">
        I like interfaces that reveal what is happening: system state, constraints, tradeoffs, and the path from asset to realtime presentation.
      </p>
    </div>
    <div class="process-map" data-reveal>
      {timeline.map(([step, title, body]) => (
        <article>
          <span>{step}</span>
          <div>
            <h3>{title}</h3>
            <p>{body}</p>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
