# Plan Maestro OS — Matriz de variables de entorno y secretos
# ADVERTENCIA: NUNCA coloques valores reales ni secretos en este archivo ni en el repositorio público.

# --- WORKER PRIVADO & ENDPOINT ---
WORKER_API_URL=https://api-worker.planmaestro-os.internal
SYNC_SIGNING_SECRET=change_me_to_a_secure_random_signing_secret

# --- NOTION INTEGRATION (Servidor / Worker únicamente) ---
NOTION_TOKEN=secret_notion_integration_token_here
NOTION_AGENDA_DB_ID=notion_agenda_database_id_here
NOTION_FITNESS_DB_ID=notion_fitness_database_id_here
NOTION_CAREER_DB_ID=notion_career_database_id_here

# --- GITHUB INTEGRATION (Worker / CI GitHub App) ---
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=change_me_to_a_secure_webhook_secret

# --- PROVEEDOR IA (Worker únicamente) ---
AI_PROVIDER_KEY=gemini_api_key_here
